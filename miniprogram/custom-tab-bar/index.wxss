.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 99;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-bar-blur {
  position: absolute;
  inset: 0;
  background: rgba(250, 247, 242, 0.82);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  border-top: 1rpx solid rgba(27, 25, 40, 0.07);
}

.tab-bar-inner {
  position: relative;
  display: flex;
  flex-direction: row;
  height: 100rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 0 10rpx;
  cursor: pointer;
  transition: all 180ms ease;
  color: #A09BB8;
}

.tab-item.active {
  color: #E06844;
}

.icon-wrap {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
}

.tab-item.active .icon-wrap {
  transform: translateY(-4rpx);
}

.icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-label {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
  line-height: 1;
  transition: color 180ms ease;
}
