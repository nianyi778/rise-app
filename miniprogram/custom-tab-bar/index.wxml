<view class="tab-bar">
  <view class="tab-bar-blur"/>
  <view class="tab-bar-inner">

    <!-- 首页 -->
    <view class="tab-item {{selected === 0 ? 'active' : ''}}" bindtap="onTabTap" data-index="0">
      <view class="icon-wrap">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
      </view>
      <text class="tab-label">首页</text>
    </view>

    <!-- 复盘 -->
    <view class="tab-item {{selected === 1 ? 'active' : ''}}" bindtap="onTabTap" data-index="1">
      <view class="icon-wrap">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
      </view>
      <text class="tab-label">复盘</text>
    </view>

    <!-- 报告 -->
    <view class="tab-item {{selected === 2 ? 'active' : ''}}" bindtap="onTabTap" data-index="2">
      <view class="icon-wrap">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"/>
          <line x1="12" y1="20" x2="12" y2="4"/>
          <line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
      </view>
      <text class="tab-label">报告</text>
    </view>

    <!-- 目标 -->
    <view class="tab-item {{selected === 3 ? 'active' : ''}}" bindtap="onTabTap" data-index="3">
      <view class="icon-wrap">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <circle cx="12" cy="12" r="6"/>
          <circle cx="12" cy="12" r="2"/>
        </svg>
      </view>
      <text class="tab-label">目标</text>
    </view>

  </view>
</view>
