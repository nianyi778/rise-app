<view class="tab-bar">
  <view class="tab-bar-blur"/>
  <view class="tab-bar-inner">

    <view class="tab-item {{selected === 0 ? 'active' : ''}}" bindtap="onTabTap" data-index="0">
      <image class="tab-icon" src="{{selected === 0 ? '/assets/icons/home-active.png' : '/assets/icons/home.png'}}" mode="aspectFit"/>
      <text class="tab-label">首页</text>
    </view>

    <view class="tab-item {{selected === 1 ? 'active' : ''}}" bindtap="onTabTap" data-index="1">
      <image class="tab-icon" src="{{selected === 1 ? '/assets/icons/reflect-active.png' : '/assets/icons/reflect.png'}}" mode="aspectFit"/>
      <text class="tab-label">复盘</text>
    </view>

    <view class="tab-item {{selected === 2 ? 'active' : ''}}" bindtap="onTabTap" data-index="2">
      <image class="tab-icon" src="{{selected === 2 ? '/assets/icons/report-active.png' : '/assets/icons/report.png'}}" mode="aspectFit"/>
      <text class="tab-label">报告</text>
    </view>

    <view class="tab-item {{selected === 3 ? 'active' : ''}}" bindtap="onTabTap" data-index="3">
      <image class="tab-icon" src="{{selected === 3 ? '/assets/icons/goals-active.png' : '/assets/icons/goals.png'}}" mode="aspectFit"/>
      <text class="tab-label">目标</text>
    </view>

  </view>
</view>
