@import '../../app.wxss';

/* ─── 页面根容器（可滚动，渐变背景直接放这里避免 fixed 层级问题） ── */
.wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  padding-bottom: 32rpx;
  background: linear-gradient(155deg, #F2DECE 0%, #E6D8EE 32%, #C6DCF0 68%, #CEEADE 100%);
  min-height: 100vh;
}

/* ─── 步骤内容区 ──────────────────────────────── */
.step-inner {
  padding: 24rpx 48rpx 0;
  width: 100%;
  box-sizing: border-box;
  flex: 1;
}

/* ─── 品牌 ────────────────────────────────────── */
.brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 56rpx;
}

.brand-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.brand-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.4rpx;
}

/* ─── Step 0：标题 & 输入 ─────────────────────── */
.h1 {
  display: block;
  font-size: 52rpx;
  font-weight: 900;
  color: var(--ink);
  line-height: 1.32;
  letter-spacing: -0.6rpx;
  margin-bottom: 18rpx;
}

.sub {
  display: block;
  font-size: 30rpx;
  color: var(--ink-soft);
  line-height: 1.68;
  margin-bottom: 48rpx;
  font-weight: 500;
}

.field-wrap {
  background: var(--glass-strong);
  backdrop-filter: var(--blur);
  -webkit-backdrop-filter: var(--blur);
  border: 1.5rpx solid var(--gborder);
  border-radius: var(--r-md);
  padding: 28rpx 32rpx;
  margin-bottom: 36rpx;
  transition: border-color 200ms;
  box-shadow: inset 0 4rpx 16rpx rgba(80,60,120,0.05);
  width: 100%;
  box-sizing: border-box;
}

.field-wrap.focused {
  border-color: var(--rose);
}

.field {
  width: 100%;
  min-height: 200rpx;
  font-size: 32rpx;
  font-family: inherit;
  color: var(--ink);
  line-height: 1.65;
  background: transparent;
}

.field-ph {
  color: var(--ink-muted);
}

/* ─── 分类 chip ──────────────────────────────── */
.div-label {
  display: block;
  font-size: 24rpx;
  color: var(--ink-muted);
  font-weight: 700;
  margin-bottom: 24rpx;
  text-align: center;
  letter-spacing: 0.6rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.cat-chip {
  display: flex;
  align-items: center;
  background: var(--glass);
  backdrop-filter: var(--blur-sm);
  -webkit-backdrop-filter: var(--blur-sm);
  border: 1.5rpx solid var(--gborder);
  border-radius: 100rpx;
  padding: 18rpx 32rpx;
  transition: all 200ms var(--spring);
  box-shadow: var(--sg);
}

.cat-chip.on {
  background: var(--rose);
  border-color: var(--rose);
  box-shadow: 0 8rpx 24rpx rgba(224,104,68,0.30);
}

.cat-chip-label {
  font-size: 26rpx;
  color: var(--ink-mid);
  font-weight: 700;
}

.cat-chip.on .cat-chip-label {
  color: #fff;
}

.s0-btn {
  margin-top: 8rpx;
}

/* ─── 步骤头部（返回 + 步骤数同行） ─────────── */
.step-hd {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.85);
  box-shadow: 0 4rpx 16rpx rgba(50,36,90,0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-arrow {
  font-size: 36rpx;
  color: var(--ink-mid);
  line-height: 1;
  margin-top: -2rpx;
}

/* ─── Step 1/2：向导通用 ────────────────────── */
.wiz-step {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--rose);
  letter-spacing: 2rpx;
}

.wiz-q {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: var(--ink);
  line-height: 1.30;
  letter-spacing: -0.6rpx;
  margin-bottom: 16rpx;
}

.wiz-hint {
  display: block;
  font-size: 28rpx;
  color: var(--ink-soft);
  line-height: 1.65;
  margin-bottom: 48rpx;
  font-weight: 500;
}

/* ─── 选项卡 ─────────────────────────────────── */
.opt-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.opt-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--glass);
  backdrop-filter: var(--blur);
  -webkit-backdrop-filter: var(--blur);
  border: 1.5rpx solid var(--gborder);
  border-left: 6rpx solid transparent;
  border-radius: var(--r-md);
  padding: 32rpx 28rpx;
  box-shadow: var(--sg);
  transition: border-left-color 200ms var(--spring), background 200ms;
  box-sizing: border-box;
}

.opt-card.on {
  border-left-color: var(--rose);
  background: rgba(255,255,255,0.80);
}

.opt-card-body {
  flex: 1;
  min-width: 0;
}

.opt-card-t {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 6rpx;
}

.opt-card-d {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  font-weight: 500;
  line-height: 1.5;
}

.opt-card-check {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(0.6);
  transition: opacity 200ms, transform 250ms var(--spring);
  flex-shrink: 0;
}

.opt-card-check.show {
  opacity: 1;
  transform: scale(1);
}

/* ─── 时长 Slider ─────────────────────────────── */
.slider-wrap {
  background: var(--glass);
  backdrop-filter: var(--blur);
  -webkit-backdrop-filter: var(--blur);
  border: 1.5rpx solid var(--gborder);
  border-radius: var(--r-md);
  padding: 32rpx 32rpx 24rpx;
  margin-bottom: 48rpx;
  box-shadow: var(--sg);
  box-sizing: border-box;
}

.slider-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.slider-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-mid);
}

.slider-val {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--rose);
}

.time-slider {
  width: 100%;
}

.slider-tips {
  display: flex;
  justify-content: space-between;
  margin-top: -8rpx;
}

.slider-tips text {
  font-size: 22rpx;
  color: var(--ink-muted);
  font-weight: 600;
}

/* ─── Loading 按钮态 ──────────────────────────── */
.btn-loading {
  opacity: 0.72;
}

/* ─── 底部进度点 ──────────────────────────────── */
.prog-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx 0 48rpx;
  flex-shrink: 0;
}

.prog-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: var(--rose);
  opacity: 0.25;
  transition: all 350ms cubic-bezier(0.22,1,0.36,1);
}

.prog-dot.on {
  width: 44rpx;
  border-radius: 6rpx;
  opacity: 1;
}

/* ─── Step 0 错落入场动画 ─────────────────────── */
.s0-brand {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 60ms both;
}

.s0-h1 {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 120ms both;
}

.s0-sub {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 180ms both;
}

.s0-field {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 240ms both;
}

.s0-chips-label {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 300ms both;
}

.s0-chips {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 360ms both;
}

.s0-btn {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 420ms both;
}
