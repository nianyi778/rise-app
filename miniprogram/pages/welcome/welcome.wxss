@import '../../app.wxss';

/* ─── 页面容器 ─────────────────────────────────── */
.wrap {
  position: relative;
  height: 100vh;
  overflow: hidden;
}

.screen {
  position: relative;
  z-index: 1;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ─── 步骤滑动容器 ─────────────────────────────── */
.steps-outer {
  flex: 1;
  overflow: hidden;
  position: relative;
}

.steps-row {
  display: flex;
  width: 300%;
  height: 100%;
}

.step-panel {
  width: 33.3333%;
  flex-shrink: 0;
  height: 100%;
  overflow: hidden;
}

.step-scroll {
  height: 100%;
  padding: 20rpx 52rpx 48rpx;
}

/* ─── 品牌 ────────────────────────────────────── */
.brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 60rpx;
}

.brand-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.4rpx;
}

/* ─── Step 0：标题 & 输入 ─────────────────────── */
.h1 {
  display: block;
  font-size: 58rpx;
  font-weight: 900;
  color: var(--ink);
  line-height: 1.28;
  letter-spacing: -0.8rpx;
  margin-bottom: 20rpx;
}

.sub {
  display: block;
  font-size: 30rpx;
  color: var(--ink-soft);
  line-height: 1.68;
  margin-bottom: 52rpx;
  font-weight: 500;
}

.field-wrap {
  background: var(--glass-strong);
  backdrop-filter: var(--blur);
  -webkit-backdrop-filter: var(--blur);
  border: 1.5rpx solid var(--gborder);
  border-radius: var(--r-md);
  padding: 28rpx 32rpx;
  margin-bottom: 36rpx;
  transition: border-color 200ms;
  box-shadow: inset 0 4rpx 16rpx rgba(80,60,120,0.05);
}

.field-wrap.focused {
  border-color: var(--rose);
}

.field {
  width: 100%;
  min-height: 240rpx;
  font-size: 34rpx;
  font-family: inherit;
  color: var(--ink);
  line-height: 1.65;
  background: transparent;
}

.field-ph {
  color: var(--ink-muted);
}

/* ─── 分类 chip ──────────────────────────────── */
.div-label {
  display: block;
  font-size: 24rpx;
  color: var(--ink-muted);
  font-weight: 700;
  margin-bottom: 24rpx;
  text-align: center;
  letter-spacing: 0.6rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 56rpx;
}

.cat-chip {
  display: flex;
  align-items: center;
  background: var(--glass);
  backdrop-filter: var(--blur-sm);
  -webkit-backdrop-filter: var(--blur-sm);
  border: 1.5rpx solid var(--gborder);
  border-radius: 100rpx;
  padding: 20rpx 36rpx;
  transition: all 200ms var(--spring);
  box-shadow: var(--sg);
}

.cat-chip.on {
  background: var(--rose);
  border-color: var(--rose);
  box-shadow: 0 8rpx 24rpx rgba(224,104,68,0.30);
}

.cat-chip-label {
  font-size: 26rpx;
  color: var(--ink-mid);
  font-weight: 700;
}

.cat-chip.on .cat-chip-label {
  color: #fff;
}

.s0-btn {
  margin-top: 8rpx;
}

/* ─── Step 1/2：向导通用 ────────────────────── */
.wiz-step {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--rose);
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 20rpx;
}

.wiz-q {
  display: block;
  font-size: 52rpx;
  font-weight: 900;
  color: var(--ink);
  line-height: 1.30;
  letter-spacing: -0.6rpx;
  margin-bottom: 16rpx;
}

.wiz-hint {
  display: block;
  font-size: 28rpx;
  color: var(--ink-soft);
  line-height: 1.65;
  margin-bottom: 56rpx;
  font-weight: 500;
}

/* ─── 选项卡 ─────────────────────────────────── */
.opt-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 56rpx;
}

.opt-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--glass);
  backdrop-filter: var(--blur);
  -webkit-backdrop-filter: var(--blur);
  border: 1.5rpx solid var(--gborder);
  border-left: 6rpx solid transparent;
  border-radius: var(--r-md);
  padding: 36rpx 32rpx;
  box-shadow: var(--sg);
  transition: border-left-color 200ms var(--spring), background 200ms;
}

.opt-card.on {
  border-left-color: var(--rose);
  background: rgba(255,255,255,0.80);
}

.opt-card-body {
  flex: 1;
}

.opt-card-t {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 6rpx;
}

.opt-card-d {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  font-weight: 500;
  line-height: 1.5;
}

.opt-card-check {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(0.6);
  transition: opacity 200ms, transform 250ms var(--spring);
  flex-shrink: 0;
}

.opt-card-check.show {
  opacity: 1;
  transform: scale(1);
}

/* ─── 时长 Slider ─────────────────────────────── */
.slider-wrap {
  background: var(--glass);
  backdrop-filter: var(--blur);
  -webkit-backdrop-filter: var(--blur);
  border: 1.5rpx solid var(--gborder);
  border-radius: var(--r-md);
  padding: 32rpx 36rpx 24rpx;
  margin-bottom: 56rpx;
  box-shadow: var(--sg);
}

.slider-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.slider-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-mid);
}

.slider-val {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--rose);
}

slider {
  width: 100%;
}

.slider-tips {
  display: flex;
  justify-content: space-between;
  margin-top: -8rpx;
}

.slider-tips text {
  font-size: 22rpx;
  color: var(--ink-muted);
  font-weight: 600;
}

/* ─── Loading 按钮态 ──────────────────────────── */
.btn-loading {
  opacity: 0.72;
}

/* ─── 底部进度点 ──────────────────────────────── */
.prog-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 0 60rpx;
  flex-shrink: 0;
}

.prog-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: var(--rose);
  opacity: 0.25;
  transition: all 350ms cubic-bezier(0.22,1,0.36,1);
}

.prog-dot.on {
  width: 44rpx;
  border-radius: 6rpx;
  opacity: 1;
}

/* ─── Step 0 错落入场动画 ─────────────────────── */
.s0-brand {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 60ms both;
}

.s0-h1 {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 120ms both;
}

.s0-sub {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 180ms both;
}

.s0-field {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 240ms both;
}

.s0-chips-label {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 300ms both;
}

.s0-chips {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 360ms both;
}

.s0-btn {
  animation: staggerFadeUp 380ms cubic-bezier(0.22,1,0.36,1) 420ms both;
}
