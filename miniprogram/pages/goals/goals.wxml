<!-- PAGE 08 · GOALS — 我的要事 + Pro 升级引导 -->
<view class="wrap">
  <view class="bg-mesh">
    <view class="bg-glow-rose"/>
    <view class="bg-glow-violet"/>
  </view>

  <view class="screen">
    <view class="status-bar"/>

    <!-- 顶部 -->
    <view class="g-nav">
      <text class="g-nav-title">我的要事</text>
      <view class="g-nav-badge {{isPro ? 'pro' : 'free'}}">
        <text>{{goals.length}} / {{maxGoals}}</text>
      </view>
    </view>

    <scroll-view class="gscroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="gi">

        <!-- 骨架 -->
        <block wx:if="{{loading}}">
          <view class="skeleton" style="height:160rpx;border-radius:28rpx;margin-bottom:20rpx"/>
          <view class="skeleton" style="height:160rpx;border-radius:28rpx;margin-bottom:20rpx;opacity:0.6"/>
        </block>

        <!-- 目标列表 -->
        <block wx:else>
          <view
            wx:for="{{goals}}"
            wx:key="_id"
            class="gc glass {{pageEntered ? 'entered' : ''}}"
            style="animation-delay:{{index * 80}}ms"
            bindtap="onGoalTap"
            data-id="{{item._id}}"
          >
            <!-- 进度环 SVG（r=24, circ=150.8） -->
            <view class="grw">
              <svg width="116rpx" height="116rpx" viewBox="0 0 58 58">
                <circle cx="29" cy="29" r="24" fill="none" stroke="rgba(27,25,40,0.10)" stroke-width="4"/>
                <circle cx="29" cy="29" r="24" fill="none"
                  stroke="{{item.color}}" stroke-width="4"
                  stroke-linecap="round"
                  stroke-dasharray="150.8"
                  stroke-dashoffset="{{item.dashOffset}}"
                  transform="rotate(-90 29 29)"/>
              </svg>
              <view class="gre">
                <view class="gre-icon" style="background:{{item.colorGlow}}">
                  <!-- 通用圆点替代 category icon（避免 use 标签在 WX 不稳定） -->
                  <view class="gre-dot" style="background:{{item.color}}"/>
                </view>
              </view>
            </view>

            <!-- 目标信息 -->
            <view class="ginfo">
              <text class="gtitle">{{item.title}}</text>
              <text class="gmeta">第 {{item.dayIndex}} 天 · {{item.phaseName}}</text>
              <text class="gact {{item.isActive ? 'rose' : 'muted'}}">
                {{item.isActive ? (item.todayAction ? item.todayAction : '今日待生成') : '已暂停'}}
              </text>
            </view>

            <!-- 箭头 SVG -->
            <view class="g-arrow">
              <svg width="36rpx" height="36rpx" viewBox="0 0 24 24" fill="none" stroke="rgba(27,25,40,0.2)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </view>

            <!-- 锁遮罩（免费版第 2+ 个） -->
            <view class="lock-overlay" wx:if="{{!isPro && index >= 1}}" catchtap="onAddGoal">
              <view class="lock-box">
                <svg width="44rpx" height="44rpx" viewBox="0 0 24 24" fill="none" stroke="rgba(27,25,40,0.45)" stroke-width="2" stroke-linecap="round">
                  <rect x="3" y="11" width="18" height="11" rx="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <text class="lock-txt">Pro 解锁</text>
              </view>
            </view>
          </view>

          <!-- 锁定的额外目标槽（免费版，当 goals < 1 时不显示空槽） -->
          <view class="lk" wx:if="{{!isPro && goals.length >= 1}}">
            <view class="lkico">
              <svg width="48rpx" height="48rpx" viewBox="0 0 24 24" fill="none" stroke="#A6A0B8" stroke-width="2" stroke-linecap="round">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </view>
            <text class="lktxt">还可以添加 {{maxGoals - goals.length > 0 ? (maxGoals - goals.length) : 0}} 个要事\n升级 Pro 最多 5 个</text>
          </view>

          <!-- 添加按钮 -->
          <button class="addbtn" bindtap="onAddGoal">
            <svg width="36rpx" height="36rpx" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="12" y1="5" x2="12" y2="19"/>
              <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            <text>添加新要事</text>
          </button>

          <!-- Pro 升级 banner -->
          <view class="pro-card" bindtap="onGoUpgrade" wx:if="{{!isPro}}">
            <view class="pro-icon-box">
              <svg width="44rpx" height="44rpx" viewBox="0 0 24 24" fill="none" stroke="#E06844" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L4 6v6c0 5.5 3.5 10.7 8 12 4.5-1.3 8-6.5 8-12V6L12 2z"/>
                <polyline points="8 12 11 15 16 9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </view>
            <view class="pro-info">
              <text class="pro-nm">解锁 Rise Pro</text>
              <text class="pro-dc">5 个要事 · 深度复盘 · 完整报告</text>
            </view>
            <view class="pro-tag">
              <text>¥29/月</text>
            </view>
          </view>
        </block>

      </view>
    </scroll-view>
  </view>

  <!-- Pro 升级弹窗 -->
  <view class="upgrade-mask" wx:if="{{showUpgrade}}" bindtap="onCloseUpgrade">
    <view class="upgrade-modal" catchtap="">
      <view class="upgrade-close" bindtap="onCloseUpgrade">
        <svg width="36rpx" height="36rpx" viewBox="0 0 24 24" fill="none" stroke="rgba(27,25,40,0.4)" stroke-width="2.5" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </view>
      <view class="upgrade-icon-box">
        <svg width="56rpx" height="56rpx" viewBox="0 0 24 24" fill="none" stroke="#E06844" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L4 6v6c0 5.5 3.5 10.7 8 12 4.5-1.3 8-6.5 8-12V6L12 2z"/>
          <polyline points="8 12 11 15 16 9" stroke-width="2.5"/>
        </svg>
      </view>
      <text class="upgrade-title">解锁 Rise Pro</text>
      <text class="upgrade-sub">同时守护最多 5 个重要目标</text>
      <view class="upgrade-features">
        <view class="upgrade-feat" wx:for="{{proFeatures}}" wx:key="*this">
          <view class="feat-dot"/>
          <text class="feat-txt">{{item}}</text>
        </view>
      </view>
      <button class="btn btn-rose upgrade-cta" bindtap="onGoUpgrade">
        <text>¥29/月 · 立即升级</text>
      </button>
      <text class="upgrade-hint">年付 ¥199，约 ¥16.6/月</text>
    </view>
  </view>
</view>
