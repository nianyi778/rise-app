@import '../../app.wxss';

.wrap {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.screen {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* 导航栏 */
.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 44rpx 0;
  height: 88rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.back-arrow {
  font-size: 32rpx;
  color: var(--ink-soft);
}

.back-label {
  font-size: 28rpx;
  color: var(--ink-soft);
  font-weight: 600;
}

.goal-hint {
  font-size: 24rpx;
  color: var(--ink-muted);
  font-weight: 700;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 主体 */
.body {
  flex: 1;
  padding: 20rpx 48rpx 0;
  overflow-y: auto;
}

/* 进度条 */
.prog-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 68rpx;
}

.pb {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255,255,255,0.32);
  transition: background 300ms;
}

.pb.done { background: var(--ink); }
.pb.cur  { background: var(--rose); }

/* 步骤标签 */
.step-label {
  display: block;
  font-size: 22rpx;
  font-weight: 800;
  color: var(--rose);
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 20rpx;
}

/* 问题标题 */
.q {
  display: block;
  font-size: 52rpx;
  font-weight: 900;
  color: var(--ink);
  line-height: 1.3;
  letter-spacing: -0.6rpx;
  margin-bottom: 16rpx;
}

.hint {
  display: block;
  font-size: 28rpx;
  color: var(--ink-soft);
  margin-bottom: 56rpx;
  line-height: 1.65;
  font-weight: 500;
}

/* 选项列表 */
.opt-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.opt {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: var(--glass);
  backdrop-filter: var(--blur);
  -webkit-backdrop-filter: var(--blur);
  border: 3rpx solid var(--gborder);
  border-radius: var(--r-md);
  padding: 32rpx 36rpx;
  transition: all 180ms;
  box-shadow: var(--sg);
}

.opt.on {
  background: var(--ink);
  border-color: var(--ink);
}

.opt-body {
  flex: 1;
}

.opt-t {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 4rpx;
}

.opt.on .opt-t { color: #fff; }

.opt-d {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
}

.opt.on .opt-d { color: rgba(255,255,255,0.55); }

/* 底部 */
.footer {
  padding: 0 48rpx 64rpx;
}

.next-btn.loading {
  opacity: 0.7;
}
