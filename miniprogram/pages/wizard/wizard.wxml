<!-- PAGE 02 · WIZARD — AI 对话向导（卡片式，3步） -->
<view class="wrap">
  <view class="bg-mesh">
    <view class="bg-glow-rose"/>
    <view class="bg-glow-violet"/>
  </view>

  <view class="screen">
    <view class="status-bar"/>

    <!-- 顶部导航 -->
    <view class="nav">
      <view class="back-btn" bindtap="onBack">
        <text class="back-arrow">←</text>
        <text class="back-label">{{step === 1 ? '返回' : '上一步'}}</text>
      </view>
      <text class="goal-hint">{{goalTitle}}</text>
    </view>

    <view class="body">
      <!-- 进度条 -->
      <view class="prog-bar">
        <view wx:for="{{[1,2,3]}}" wx:key="*this"
          class="pb {{item < step ? 'done' : (item === step ? 'cur' : '')}}"/>
      </view>

      <!-- STEP 1：最大阻力 -->
      <block wx:if="{{step === 1}}">
        <text class="step-label">STEP 1 / 3</text>
        <text class="q">阻止你的<br/>最大原因是？</text>
        <text class="hint">了解阻力，Rise 才能帮你设计真正有效的行动</text>
        <view class="opt-list">
          <view
            wx:for="{{blockers}}" wx:key="key"
            class="opt {{selectedBlocker === item.key ? 'on' : ''}}"
            bindtap="onSelectBlocker"
            data-key="{{item.key}}"
          >
            <view class="opt-body">
              <text class="opt-t">{{item.label}}</text>
              <text class="opt-d">{{item.desc}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- STEP 2：专注时段 -->
      <block wx:if="{{step === 2}}">
        <text class="step-label">STEP 2 / 3</text>
        <text class="q">你通常什么时候<br/>有零散时间？</text>
        <text class="hint">Rise 会在这个时段提醒你，找到真正属于你的 25 分钟</text>
        <view class="opt-list">
          <view
            wx:for="{{times}}" wx:key="key"
            class="opt {{selectedTime === item.key ? 'on' : ''}}"
            bindtap="onSelectTime"
            data-key="{{item.key}}"
          >
            <view class="opt-body">
              <text class="opt-t">{{item.label}}</text>
              <text class="opt-d">{{item.desc}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- STEP 3：每日时长 -->
      <block wx:if="{{step === 3}}">
        <text class="step-label">STEP 3 / 3</text>
        <text class="q">每天能给这个目标<br/>多少时间？</text>
        <text class="hint">从小开始，坚持比完美更重要。Rise 推荐 25 分钟</text>
        <view class="opt-list">
          <view
            wx:for="{{minutes}}" wx:key="key"
            class="opt {{selectedMinutes === item.key ? 'on' : ''}}"
            bindtap="onSelectMinutes"
            data-key="{{item.key}}"
          >
            <view class="opt-body">
              <text class="opt-t">{{item.label}}</text>
              <text class="opt-d">{{item.desc}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 底部按钮 -->
    <view class="footer">
      <button
        class="btn btn-rose next-btn {{submitting ? 'loading' : ''}}"
        bindtap="onNext"
        disabled="{{submitting}}"
      >
        <text>{{step < 3 ? '下一步' : (submitting ? 'AI 分析中…' : '生成我的计划')}}</text>
      </button>
    </view>
  </view>
</view>
