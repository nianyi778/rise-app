<!-- PAGE 02 · WIZARD — AI 卡片向导（3步） -->
<view class="wrap">
  <view class="bg-mesh">
    <view class="bg-glow-rose"/>
    <view class="bg-glow-violet"/>
  </view>

  <view class="screen">
    <view class="status-bar"/>

    <!-- 导航栏 -->
    <view class="nav">
      <view class="back-btn" bindtap="onBack">
        <view class="back-chevron"/>
        <text class="back-label">{{currentCard === 0 ? '返回' : '上一步'}}</text>
      </view>
      <text class="goal-hint">{{goalTitle}}</text>
    </view>

    <!-- 进度条 -->
    <view class="prog-wrap">
      <view class="prog-bar">
        <view class="pb {{currentCard === 0 ? 'cur' : 'done'}}"/>
        <view class="pb {{currentCard === 1 ? 'cur' : (currentCard > 1 ? 'done' : '')}}"/>
        <view class="pb {{currentCard === 2 ? 'cur' : ''}}"/>
      </view>
      <text class="step-badge">{{currentCard + 1}} / 3</text>
    </view>

    <!-- 滑动卡片区域 -->
    <view class="wiz-slider-wrap">
      <view class="wiz-slider" style="{{sliderStyle}}">

        <!-- ─── Card 0: 时间确认 ─── -->
        <view class="wiz-card">
          <text class="wiz-q">{{q0}}</text>
          <view class="opt-list">
            <view
              wx:for="{{durations}}" wx:key="key"
              class="opt-card {{duration === item.key ? 'on' : ''}}"
              bindtap="onDurationTap" data-key="{{item.key}}"
            >
              <text class="opt-t">{{item.label}}</text>
              <view class="opt-check {{duration === item.key ? 'show' : ''}}"/>
            </view>
          </view>
          <view class="ai-bubble">
            <view class="ai-avatar"><text class="ai-r">R</text></view>
            <view class="ai-msg">
              <text class="ai-text">了解你的目标背景，帮我更好地为你设计节奏</text>
            </view>
          </view>
        </view>

        <!-- ─── Card 1: AI 分析 + 时间选择 ─── -->
        <view class="wiz-card">
          <text class="wiz-q">{{q1}}</text>
          <view class="ai-bubble ai-bubble-mb">
            <view class="ai-avatar"><text class="ai-r">R</text></view>
            <view class="ai-msg">
              <text class="ai-text">{{aiAnalysis}}</text>
            </view>
          </view>
          <text class="sec-label">选择你的专注时段</text>
          <view class="opt-list">
            <view
              wx:for="{{times}}" wx:key="key"
              class="opt-card {{selectedTime === item.key ? 'on' : ''}}"
              bindtap="onTimeTap" data-key="{{item.key}}"
            >
              <view class="opt-text-wrap">
                <text class="opt-t">{{item.label}}</text>
                <text class="opt-d">{{item.desc}}</text>
              </view>
              <view class="opt-check {{selectedTime === item.key ? 'show' : ''}}"/>
            </view>
          </view>
        </view>

        <!-- ─── Card 2: 方案确认 ─── -->
        <view class="wiz-card">
          <text class="wiz-q">{{q2}}</text>
          <view class="plan-card">
            <text class="plan-goal">{{goalTitle}}</text>
            <view class="plan-sep"/>
            <text class="plan-stage-lbl">第一阶段</text>
            <text class="plan-phase">{{phaseName}}</text>
            <view class="plan-footer-row">
              <view class="plan-min-chip">
                <text class="plan-min-n">{{dailyMinutes}}</text>
                <text class="plan-min-u"> 分钟 / 天</text>
              </view>
            </view>
          </view>
          <view class="ai-bubble ai-bubble-mt">
            <view class="ai-avatar"><text class="ai-r">R</text></view>
            <view class="ai-msg">
              <text class="ai-text">{{encouragement}}</text>
            </view>
          </view>
        </view>

      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="footer">
      <button
        wx:if="{{currentCard < 2}}"
        class="btn btn-rose"
        bindtap="onNext"
      >
        <text>下一步</text>
      </button>
      <button
        wx:else
        class="btn btn-rose {{submitting ? 'loading' : ''}}"
        bindtap="onConfirm"
        disabled="{{submitting}}"
      >
        <view wx:if="{{submitting}}" class="btn-loader"/>
        <text wx:else>开始守护</text>
      </button>
    </view>
  </view>
</view>
