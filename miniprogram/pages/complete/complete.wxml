<!-- PAGE 05 · COMPLETE — 完成庆祝，打卡心情，连击 -->

<!-- 分享卡片画布（隐藏，type="2d"） -->
<canvas
  id="shareCard"
  type="2d"
  style="position:fixed;left:-9999px;top:-9999px;width:375px;height:525px;opacity:0;pointer-events:none;"
/>

<!-- 全屏粒子画布（z-index 1，内容层 z-index 2 覆盖其上） -->
<canvas id="confettiCanvas" type="2d" class="confetti-canvas"/>

<view class="wrap">
  <view class="bg-mesh">
    <view class="bg-glow-rose"/>
    <view class="bg-glow-violet"/>
  </view>

  <view class="screen">
    <view class="status-bar"/>

    <scroll-view class="body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="cinner">

        <!-- 星爆 SVG：中心圆 + 8 射线 + 4 外点，匹配原型 ico-star -->
        <view class="starburst">
          <svg width="160rpx" height="160rpx" viewBox="0 0 80 80">
            <circle cx="40" cy="40" r="16" fill="#E06844" opacity="0.9"/>
            <!-- 8 rays -->
            <line x1="40" y1="8"  x2="40" y2="18" stroke="#E06844" stroke-width="4" stroke-linecap="round"/>
            <line x1="40" y1="62" x2="40" y2="72" stroke="#E06844" stroke-width="4" stroke-linecap="round"/>
            <line x1="8"  y1="40" x2="18" y2="40" stroke="#7468E8" stroke-width="4" stroke-linecap="round"/>
            <line x1="62" y1="40" x2="72" y2="40" stroke="#7468E8" stroke-width="4" stroke-linecap="round"/>
            <line x1="17" y1="17" x2="24" y2="24" stroke="#53A47A" stroke-width="4" stroke-linecap="round"/>
            <line x1="56" y1="56" x2="63" y2="63" stroke="#53A47A" stroke-width="4" stroke-linecap="round"/>
            <line x1="63" y1="17" x2="56" y2="24" stroke="#E06844" stroke-width="4" stroke-linecap="round"/>
            <line x1="17" y1="63" x2="24" y2="56" stroke="#7468E8" stroke-width="4" stroke-linecap="round"/>
            <!-- outer dots -->
            <circle cx="40" cy="4"  r="3" fill="#E06844" opacity="0.5"/>
            <circle cx="4"  cy="40" r="3" fill="#7468E8" opacity="0.5"/>
            <circle cx="76" cy="40" r="3" fill="#7468E8" opacity="0.5"/>
            <circle cx="40" cy="76" r="3" fill="#53A47A" opacity="0.5"/>
          </svg>
        </view>

        <!-- 完成标题 -->
        <text class="done-t">完成了！第 {{dayIndex}} 天</text>
        <text class="done-s">你又守住了今天的要事</text>

        <!-- 连击卡片（毛玻璃） -->
        <view class="streak-card glass">
          <!-- 火焰 SVG -->
          <view class="streak-icon">
            <svg width="64rpx" height="64rpx" viewBox="0 0 24 24" fill="none" stroke="#E06844" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C12 2 8 7 8 12a4 4 0 0 0 8 0c0-2-1-4-1-4s2 2 2 5a6 6 0 0 1-12 0c0-6 5-11 5-11z"/>
              <circle cx="12" cy="16" r="1.5" fill="#E06844" stroke="none"/>
            </svg>
          </view>
          <view class="streak-info">
            <text class="sc-num">连续 {{streakDays}} 天</text>
            <text class="sc-lbl">守护连击{{isNewRecord ? ' · 新纪录！' : ''}}</text>
          </view>
          <view class="streak-mins">
            <text class="sc-num">{{focusMin}} 分</text>
            <text class="sc-lbl">专注时长</text>
          </view>
        </view>

        <!-- 心情选择 -->
        <view class="mood-sec">
          <text class="mood-q">今天感觉怎么样？</text>
          <view class="mood-row">
            <button
              wx:for="{{moods}}" wx:key="key"
              class="mb {{selectedMood === item.key ? 'on' : ''}}"
              bindtap="onSelectMood"
              data-key="{{item.key}}"
            >
              <text class="mb-t">{{item.label}}</text>
            </button>
          </view>
        </view>

        <!-- 备注输入（可选） -->
        <view class="note-card glass">
          <view class="note-lbl-row">
            <svg width="28rpx" height="28rpx" viewBox="0 0 24 24" fill="none" stroke="#A6A0B8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
            </svg>
            <text class="note-lbl">记录一下（可选）</text>
          </view>
          <textarea
            class="note-textarea"
            placeholder="比想象的顺利，或者遇到了什么阻力…"
            placeholder-class="note-placeholder"
            value="{{note}}"
            bindinput="onNoteInput"
            maxlength="140"
            auto-height
          />
        </view>

        <!-- 明日预告卡（毛玻璃，绿色左边框） -->
        <view class="tomorrow-card glass" wx:if="{{tomorrowAction}}">
          <text class="tmr-lbl">明天继续</text>
          <text class="tmr-txt">{{tomorrowAction}}</text>
        </view>

        <!-- 保存按钮 -->
        <button
          class="btn btn-rose save-btn {{submitting ? 'loading' : ''}} {{submitted ? 'done' : ''}}"
          bindtap="onSave"
          disabled="{{submitting || submitted}}"
        >
          <block wx:if="{{submitted}}">
            <svg width="36rpx" height="36rpx" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <text>已保存</text>
          </block>
          <block wx:elif="{{submitting}}">
            <text>保存中…</text>
          </block>
          <block wx:else>
            <text>保存打卡</text>
          </block>
        </button>

        <!-- 分享按钮（保存后出现） -->
        <button
          wx:if="{{submitted}}"
          class="btn share-btn"
          bindtap="onShare"
          disabled="{{sharing}}"
        >
          <svg width="36rpx" height="36rpx" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
          </svg>
          <text>{{sharing ? '生成中…' : '分享打卡'}}</text>
        </button>

      </view>
    </scroll-view>
  </view>
</view>
