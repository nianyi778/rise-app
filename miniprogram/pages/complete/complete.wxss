@import '../../app.wxss';

.wrap {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* 全屏粒子 canvas（pointer-events:none 不遮挡交互） */
.confetti-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.screen {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.body {
  flex: 1;
}

.cinner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 48rpx 96rpx;
  text-align: center;
}

/* ── 星爆入场：springPop 0→1.2→0.95→1，弹簧感 600ms ── */
@keyframes springPop {
  0%   { transform: scale(0);    opacity: 0; }
  55%  { transform: scale(1.2);  opacity: 1; }
  75%  { transform: scale(0.95); opacity: 1; }
  100% { transform: scale(1.0);  opacity: 1; }
}

.starburst {
  margin-bottom: 36rpx;
  animation: springPop 600ms cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
}

/* ── 完成文字 ── */
.done-t {
  display: block;
  font-size: 52rpx;
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -1rpx;
  margin-bottom: 12rpx;
  animation: fadeUp 380ms var(--spring) both;
  animation-delay: 80ms;
}

.done-s {
  display: block;
  font-size: 30rpx;
  color: var(--ink-soft);
  margin-bottom: 52rpx;
  font-weight: 500;
  animation: fadeUp 380ms var(--spring) both;
  animation-delay: 130ms;
}

/* ── 连击卡片（毛玻璃） ── */
.streak-card {
  border-radius: var(--r-lg);
  padding: 32rpx 44rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 52rpx;
  width: 100%;
  box-shadow: var(--sg);
  animation: fadeUp 380ms var(--spring) both;
  animation-delay: 200ms;
}

.streak-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.streak-info {
  flex: 1;
  text-align: left;
}

.streak-mins {
  text-align: right;
}

.sc-num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--rose);
  letter-spacing: -0.6rpx;
  line-height: 1;
}

.sc-lbl {
  display: block;
  font-size: 22rpx;
  color: var(--ink-soft);
  font-weight: 700;
  margin-top: 6rpx;
}

/* ── 心情选择 ── */
.mood-sec {
  width: 100%;
  margin-bottom: 40rpx;
  animation: fadeUp 380ms var(--spring) both;
  animation-delay: 260ms;
}

.mood-q {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 28rpx;
}

.mood-row {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.mb {
  flex: 1;
  height: 72rpx;
  background: var(--glass);
  backdrop-filter: var(--blur-sm);
  -webkit-backdrop-filter: var(--blur-sm);
  border: 1.5rpx solid rgba(27, 25, 40, 0.10);
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: inherit;
  transition: all 200ms var(--spring);
  box-shadow: var(--sg);
}

.mb.on {
  background: var(--rose);
  border-color: var(--rose);
  box-shadow: 0 8rpx 24rpx rgba(224,104,68,0.28);
}

.mb:active {
  transform: scale(0.95);
}

.mb-t {
  font-size: 26rpx;
  color: var(--ink-mid);
  font-weight: 700;
}

.mb.on .mb-t {
  color: #fff;
  font-weight: 800;
}

/* ── 备注卡片 ── */
.note-card {
  width: 100%;
  border-radius: var(--r-md);
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
  text-align: left;
  animation: fadeUp 380ms var(--spring) both;
  animation-delay: 310ms;
}

.note-lbl-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.note-lbl {
  font-size: 24rpx;
  color: var(--ink-muted);
  font-weight: 800;
}

.note-textarea {
  width: 100%;
  min-height: 80rpx;
  font-size: 29rpx;
  font-family: inherit;
  color: var(--ink);
  line-height: 1.65;
  background: transparent;
}

.note-placeholder {
  color: var(--ink-muted);
}

/* ── 明日预告卡（毛玻璃，绿色左边框） ── */
.tomorrow-card {
  width: 100%;
  border-radius: var(--r-md);
  padding: 28rpx 32rpx;
  margin-bottom: 40rpx;
  text-align: left;
  border-left: 6rpx solid var(--green) !important;
  animation: fadeUp 380ms var(--spring) both;
  animation-delay: 360ms;
}

.tmr-lbl {
  display: block;
  font-size: 22rpx;
  color: var(--green);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.tmr-txt {
  display: block;
  font-size: 29rpx;
  color: var(--ink);
  font-weight: 700;
  line-height: 1.55;
}

/* ── 保存按钮 ── */
.save-btn {
  width: 100%;
  animation: fadeUp 380ms var(--spring) both;
  animation-delay: 420ms;
}

.save-btn.loading {
  opacity: 0.7;
}

.save-btn.done {
  background: var(--green) !important;
}

/* ── 分享按钮（submitted=true 后出现，delay 200ms fadeUp） ── */
.share-btn {
  width: 100%;
  margin-top: 20rpx;
  background: #fff !important;
  border: 2rpx solid var(--rose) !important;
  color: var(--rose) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 100rpx;
  height: 104rpx;
  animation: fadeUp 380ms var(--spring) 200ms both;
}

.share-btn:active {
  opacity: 0.75;
  transform: scale(0.98);
}
