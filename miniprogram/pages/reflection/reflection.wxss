@import '../../app.wxss';

.wrap {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.screen {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 顶部标题 */
.jh {
  padding: 16rpx 44rpx 28rpx;
  background: rgba(240,224,210,0.65);
  backdrop-filter: var(--blur);
  -webkit-backdrop-filter: var(--blur);
  border-bottom: 1rpx solid var(--gborder);
  flex-shrink: 0;
}

.jh-d {
  display: block;
  font-size: 23rpx;
  color: var(--ink-muted);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1.6rpx;
  margin-bottom: 6rpx;
}

.jh-t {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -0.6rpx;
}

/* 滚动区 */
.jscroll {
  flex: 1;
  padding: 32rpx 40rpx 20rpx;
  overflow-y: auto;
}

/* 今日信息卡 */
.ic {
  border-radius: var(--r-lg);
  padding: 36rpx;
  margin-bottom: 28rpx;
  opacity: 0;
  transform: translateY(32rpx);
  transition: opacity 380ms var(--spring), transform 380ms var(--spring);
}

.ic.entered {
  opacity: 1;
  transform: translateY(0);
}

.ic-tag {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1.2rpx;
  margin-bottom: 20rpx;
}

.ic-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.ic-body {
  font-size: 29rpx;
  color: var(--ink-mid);
  line-height: 1.78;
}

.ic-highlight {
  font-weight: 800;
  color: var(--ink);
}

/* 聊天气泡 */
.chat-bubble {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  animation: staggerFadeUp 300ms var(--spring) both;
}

.chat-bubble.user {
  flex-direction: row-reverse;
}

.ai-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--rose);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 900;
  color: #fff;
}

.bubble-content {
  max-width: 75%;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: var(--sg);
}

.chat-bubble.user .bubble-content {
  border-bottom-right-radius: 8rpx;
}

.chat-bubble.ai .bubble-content {
  border-bottom-left-radius: 8rpx;
}

.bubble-text {
  font-size: 29rpx;
  color: var(--ink);
  line-height: 1.65;
}

/* 打字动画 */
.typing-dots {
  display: flex;
  gap: 8rpx;
  padding: 4rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ink-muted);
  animation: dotPulse 1.4s ease-in-out infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 56rpx;
  text-align: center;
}

.empty-icon { font-size: 80rpx; margin-bottom: 32rpx; }

.empty-t {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.empty-s {
  display: block;
  font-size: 28rpx;
  color: var(--ink-soft);
  line-height: 1.65;
  margin-bottom: 48rpx;
  font-weight: 500;
}

.goto-btn { width: 100%; }

/* 底部输入区 */
.input-area {
  padding: 16rpx 32rpx 32rpx;
  flex-shrink: 0;
}

.input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-radius: 100rpx;
  padding: 12rpx 12rpx 12rpx 32rpx;
}

.chat-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
  font-family: inherit;
  height: 64rpx;
  line-height: 64rpx;
  background: transparent;
}

.chat-placeholder { color: var(--ink-muted); }

.send-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(27,25,40,0.12);
  color: var(--ink-muted);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 200ms;
}

.send-btn.active {
  background: var(--rose);
  color: #fff;
}
